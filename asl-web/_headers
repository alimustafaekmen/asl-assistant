# Response headers for the published site. Cloudflare Pages reads this file
# from the root of the uploaded folder and does not serve it as a file.
#
# The CSP is Report-Only on purpose: ONNX Runtime and MediaPipe compile WASM
# and load code and models from two CDNs, so it is enforced only after a real
# phone has run every mode on the deployed site without a violation. The CDN
# sources name the exact package versions the app loads; a version bump changes
# them here too. style-src-attr 'unsafe-inline' is there for the two style
# attributes in index.html (#frameProgress and #confidenceRing).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/onnxruntime-web@1.22.0/ https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/ https://cdn.jsdelivr.net/npm/kjua@0.9.0/ 'wasm-unsafe-eval'; connect-src 'self' https://cdn.jsdelivr.net/npm/onnxruntime-web@1.22.0/ https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/ https://storage.googleapis.com/mediapipe-models/; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self'; style-src-attr 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
