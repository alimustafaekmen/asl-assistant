# ASL Sign Language Assistant
#
# Public repository policy:
# - Keep the deployable web app, source code, tests, technical docs, and the
#   small runtime/provenance artifacts required by validation.
# - Exclude local datasets, environments, credentials, caches, personal notes,
#   historical experiments, and editor state.
#
# Important: root-level /models rules are anchored deliberately. They must not
# hide deploy-critical files under /asl-web/models or /asl-web/data.

# -----------------------------------------------------------------------------
# Operating-system and editor metadata
# -----------------------------------------------------------------------------
.DS_Store
._*
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

/.vscode/
/.idea/
/.fleet/
/.zed/
/.history/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Secrets and machine-local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
.envrc
.direnv/

*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

/credentials.json
/credentials-*.json
/client_secret*.json
/service-account*.json
/service_account*.json
/kaggle.json
/kaggle/
/.kaggle/

# -----------------------------------------------------------------------------
# Python environments, caches, coverage, and build artifacts
# -----------------------------------------------------------------------------
.venv*/
venv/
env/
__pypackages__/

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.pyre/
.pytype/
.pyright/
.tox/
.nox/

.coverage
.coverage.*
coverage.xml
htmlcov/
*.prof

*.egg-info/
.eggs/
*.egg
build/
dist/
wheelhouse/
pip-wheel-metadata/

# -----------------------------------------------------------------------------
# JavaScript, browser-test, and static-hosting local output
# -----------------------------------------------------------------------------
node_modules/
.cache/
.parcel-cache/
.vite/
.netlify/
playwright-report/
test-results/
blob-report/

# The QR view is generated in the browser. Locally exported QR snapshots are
# disposable and can become stale when the public URL changes.
/asl-web/assets/qr-*.svg
/asl-web/assets/qr-*.png

# -----------------------------------------------------------------------------
# Jupyter and generated notebook state
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
/wandb/
/mlruns/
/lightning_logs/
/tensorboard/
/checkpoints/

# -----------------------------------------------------------------------------
# Local datasets and generated model artifacts
# -----------------------------------------------------------------------------
/data/raw/
/data/processed/
/data/reference/

# Model Test word fixtures exported from the Google competition data. Its rules
# forbid redistributing the data, so they stay local; regenerate them with
# scripts/evaluation/export_model_test_word_samples.py from your own download.
/asl-web/data/model-test-samples/local/

# Root /models contains curated training/provenance artifacts. Generated model
# files remain ignored by default; only the explicitly listed, documented
# letter and word artifacts are published.
/models/**/*.pkl
/models/**/*.h5
/models/**/*.keras
/models/**/*.pt
/models/**/*.pth
/models/**/*.png
/models/**/*.csv
/models/**/*.onnx
/models/profiles/

!/models/**/*.json
!/models/**/README.md
!/models/letter/letter_model.pkl
!/models/letter/onnx_exports/letter_model_static_24_web_no_zipmap.onnx
!/models/word/web-50/word_model.onnx
!/models/word/web-50/word_model.pt
!/models/word/desktop-25/word_model.pt

# -----------------------------------------------------------------------------
# Project-local history
# -----------------------------------------------------------------------------
# Historical experiments that are not required by the published project.
/legacy/

# -----------------------------------------------------------------------------
# Logs, temporary files, editor backups, and archive bundles
# -----------------------------------------------------------------------------
*.log
*.pid
*.bak
*.orig
*.tmp
*.temp

*.zip
*.tar
*.tar.gz
*.tgz
